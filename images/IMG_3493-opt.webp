/* === MMCC BLOG CREAM reading area (blog posts) === */
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk){background:#F9F5EE !important;box-shadow:0 0 0 100vmax #F9F5EE !important;clip-path:inset(0 -100vmax) !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(h2,h3,h4,h5,h6,h2.elementor-heading-title,h3.elementor-heading-title,h4.elementor-heading-title){color:#2A2320 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(p,li,td,span,div,.elementor-widget-text-editor,strong,b,em){color:#2A2320 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) a:not(.elementor-button){color:#2A2320 !important;text-decoration:underline !important;text-underline-offset:3px;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) a:not(.elementor-button):hover{color:#665225 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) th{background:#E9E0D4 !important;color:#2A2320 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(td,th){border-color:#D8CCBB !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) img{border:0 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) .elementor-button{color:#2A2320 !important;border-color:#2A2320 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) .elementor-button:hover{color:#F9F5EE !important;background:#610209 !important;border-color:#610209 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(.elementor-widget-image,.elementor-widget-e-image) img{height:auto !important;object-fit:contain !important;}
html body.single-post [data-elementor-type="wp-post"] > .mm-blk + :is(.e-con,.elementor-section){padding-top:48px !important;--padding-top:48px !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk):has(+ .mm-blk){padding-bottom:64px !important;--padding-bottom:64px !important;}
@media(max-width:767px){
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk){padding-left:20px !important;padding-right:20px !important;--padding-left:20px !important;--padding-right:20px !important;padding-top:0 !important;padding-bottom:16px !important;--padding-top:0px !important;--padding-bottom:16px !important;margin:0 !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(.e-con,.elementor-section,.e-con-inner,.elementor-container,.elementor-column,.elementor-widget-wrap){padding:0 !important;--padding-top:0px !important;--padding-bottom:0px !important;--padding-left:0px !important;--padding-right:0px !important;margin-left:0 !important;margin-right:0 !important;gap:16px !important;--gap:16px !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk) :is(.elementor-widget-image,.elementor-widget-e-image) img{max-height:none !important;width:100% !important;}
html body.single-post [data-elementor-type="wp-post"] > .mm-blk + :is(.e-con,.elementor-section){padding-top:32px !important;--padding-top:32px !important;}
html body.single-post [data-elementor-type="wp-post"] > :is(.e-con,.elementor-section):not(.mm-blk):has(+ .mm-blk){padding-bottom:40px !important;--padding-bottom:40px !important;}
}
