/*# sourceURL=astra-theme-css-inline-css */</style><style id="filebird-block-filebird-gallery-style-inline-css">ul.filebird-block-filebird-gallery{margin:auto!important;padding:0!important;width:100%}ul.filebird-block-filebird-gallery.layout-grid{display:grid;grid-gap:20px;align-items:stretch;grid-template-columns:repeat(var(--columns),1fr);justify-items:stretch}ul.filebird-block-filebird-gallery.layout-grid li img{border:1px solid #ccc;box-shadow:2px 2px 6px 0 rgba(0,0,0,.3);height:100%;max-width:100%;-o-object-fit:cover;object-fit:cover;width:100%}ul.filebird-block-filebird-gallery.layout-masonry{-moz-column-count:var(--columns);column-count:var(--columns);-moz-column-gap:var(--space);column-gap:var(--space);display:block;overflow:auto}ul.filebird-block-filebird-gallery.layout-masonry li{margin-bottom:var(--space)}ul.filebird-block-filebird-gallery li{list-style:none}ul.filebird-block-filebird-gallery li figure{height:100%;margin:0;padding:0;position:relative;width:100%}ul.filebird-block-filebird-gallery li figure figcaption{background:linear-gradient(0deg,rgba(0,0,0,.7),rgba(0,0,0,.3) 70%,transparent);bottom:0;box-sizing:border-box;color:#fff;font-size:.8em;margin:0;max-height:100%;overflow:auto;padding:3em .77em .7em;position:absolute;text-align:center;width:100%;z-index:2}ul.filebird-block-filebird-gallery li figure figcaption a{color:inherit}

/*# sourceURL=https://majesticmainecooncats.com/wp-content/plugins/filebird/blocks/filebird-gallery/build/style-index.css */</style><style id="ai_summarization-inline-css">.ai-summarization-summary{--ai-summary-border-color:#1d2327;--ai-summary-background-color:rgba(29,35,39,.04);background-color:var(--ai-summary-background-color);border-left:4px solid var(--ai-summary-border-color);padding:1em 1.25em}.ai-summarization-summary>:last-child{margin-bottom:0}.ai-summarization-plugin-container .components-button.ai-summarization-plugin-button{justify-content:center;width:100%}.ai-summarization-plugin-container .description{color:#757575}.block-editor-block-popover .ai-summarization-block-controls-button{height:46px;margin-top:1px}

/*# sourceURL=https://majesticmainecooncats.com/wp-content/plugins/ai/build-scripts/experiments/summarization.css */</style><style id="ai_content_translation-inline-css">@keyframes ai-content-translation-text-shimmer{0%{mask-position:300% 0}to{mask-position:0 0}}.ai-content-translation--is-blocks-loading .block-editor-rich-text__editable,.ai-content-translation--is-title-loading .wp-block-post-title{opacity:.8}@media(prefers-reduced-motion:no-preference){.ai-content-translation--is-blocks-loading .block-editor-rich-text__editable,.ai-content-translation--is-title-loading .wp-block-post-title{animation:ai-content-translation-text-shimmer 2.25s linear infinite;mask-image:linear-gradient(90deg,#000 42%,rgba(0,0,0,.7) 50%,#000 58%);mask-position:300% 0;mask-repeat:repeat;mask-size:300% 100%}}.ai-content-translation-plugin__trigger.components-button.has-icon.has-text{justify-content:center;width:100%}.ai-content-translation-plugin__description{color:var(--wpds-color-fg-content-neutral-weak,#757575)}

